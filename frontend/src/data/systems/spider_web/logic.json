{
  "system_id": "spider_web",
  "system_name": "Spider Web System",
  "role": "track_and_input_logic",

  "track_policy": {
    "available_tracks": ["RLTR_R", "LRTL_L", "RLBR_L", "LRBL_R"],
    "selection_mode": "explicit",
    "rails": {
      "RLTR_R": { "co": "RIGHT", "c1": "LEFT", "c2": "TOP", "c3_short": "RIGHT", "c3_long": "BOTTOM", "spin": "R" },
      "LRTL_L": { "co": "LEFT", "c1": "RIGHT", "c2": "TOP", "c3_short": "LEFT", "c3_long": "BOTTOM", "spin": "L" },
      "RLBR_L": { "co": "RIGHT", "c1": "LEFT", "c2": "BOTTOM", "c3_short": "RIGHT", "c3_long": "TOP", "spin": "L" },
      "LRBL_R": { "co": "LEFT", "c1": "RIGHT", "c2": "BOTTOM", "c3_short": "LEFT", "c3_long": "TOP", "spin": "R" }
    },
    "c3_short_rail_max": 60,
    "note": "Track is always chosen explicitly. C3 = 60 stays on the short rail; C3 > 60 is on the adjacent long rail."
  },

  "input_mode": {
    "type": "solve_one_of_four",
    "solve_target_selection": "explicit",
    "targets": ["CO_f", "C1_f", "C3_f", "HP"],
    "description": "The user selects the solve target; the other three values are inputs. Empty fields are never used to infer the target."
  },

  "spin_policy": {
    "mode": "track_suffix",
    "hp_selection_range": [-4, 4],
    "r_tracks_allow": [0, 1, 2, 3, 4],
    "l_tracks_allow": [0, -1, -2, -3, -4],
    "hp_n": "10 * |HP_sel|"
  },

  "calculation_policy": {
    "calculation_allowed": true,
    "formula": "C3_f = CO_f - C1_f + HP_n",
    "implementation": "frontend/src/domain/spiderWeb/spiderWebSolver.ts",
    "hp_inverse": "exact 0/10/20/30/40 only (no rounding)"
  },

  "continuation_policy": {
    "marks": ["C4", "C5", "C6"],
    "spin_direction": "track spin when C3 <= 60; reversed when C3 > 60",
    "tip_delta_deg": [0, 5, 10, 13, 18],
    "decay": [1.0, 0.8, 0.7],
    "implementation": "frontend/src/domain/spiderWeb/spiderWebContinuation.ts"
  },

  "validation_hints": {
    "require_anchor_match": true,
    "on_invalid_input": "error"
  },

  "meta": {
    "spec_version": "v2.0",
    "last_updated": "2026-10-19"
  }
}
